# Gemini API Key (必須)
# Google AI Studio (https://aistudio.google.com/apikey) で取得
GEMINI_API_KEY=your-gemini-api-key

# Optional: use the previous models instead of the 3.8/3.1 defaults
# LLM_MODEL=gemini-2.5-flash
# TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: カスタムRSSフィード (カンマ区切り)
# CUSTOM_RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml