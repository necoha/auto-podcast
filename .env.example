# Gemini API Key (必須)
# Google AI Studio (https://aistudio.google.com/apikey) で取得
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the default models or return to normal speaking speed
# LLM_MODEL=gemini-2.5-flash
# TTS_MODEL=gemini-3.1-flash-tts-preview
# TTS_TEMPO=1.0

# Optional: カスタムRSSフィード (カンマ区切り)
# CUSTOM_RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml